<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/main_title"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/ink" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/main_welcome"
        android:textSize="14sp"
        android:textColor="@color/muted"
        android:lineSpacingExtra="4dp" />

    <TextView
        android:id="@+id/tvOverlayStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:textSize="14sp"
        android:textColor="@color/primary"
        android:text="@string/overlay_ok" />

    <Button
        android:id="@+id/btnOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/btn_request_overlay"
        android:textAllCaps="false" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/api_key_label"
        android:textSize="15sp"
        android:textColor="@color/ink"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etApiKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:hint="@string/api_key_hint"
        android:inputType="textPassword"
        android:singleLine="true"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnSaveKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/btn_save_key"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/btnStartPet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/btn_start_pet"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/btnStopPet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/btn_stop_pet"
        android:textAllCaps="false" />

</LinearLayout>